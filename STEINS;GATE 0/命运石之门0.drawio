            <mxPoint x="4900" y="2540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Me8vX5A-aUXr7QQobTB1-8" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="2025年&lt;div&gt;桶子给2011年7月7日的铃羽录制视频&lt;/div&gt;&lt;div&gt;胸针给2010年8月21日的胸针录制视频&lt;/div&gt;&lt;div&gt;胸针和女武神组织基地内的伙伴道别&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;伙伴：桶子、真帆、由季、篝、&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;铃羽、琉华子&lt;/div&gt;&lt;div&gt;胸针乘坐时间机器初号机，前往过去寻找真由理和铃羽&lt;/div&gt;&lt;div&gt;计划找到他们后，一起直接前往2036年&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;推测：&lt;/div&gt;&lt;div&gt;届时，应该会直接进行世界线跳跃&lt;/div&gt;&lt;div&gt;胸针也会直接跳跃到命运石之门世界线的2036年&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="310" x="4590" y="4385" as="geometry" />
