        <mxCell id="Y0y0fFugKPorP2vDXaIm-41" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="12月15日&lt;div&gt;和教授汇报&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus情况&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;讨论&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus拥有情感问题&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;教授出去和茱蒂打电话&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;和真帆&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 0, 0), rgb(255, 255, 255));&quot;&gt;讨论红莉栖的电脑密码&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;以及圣诞节&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;因为世界线变动担心真由理，回Lab找真由理&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;遇到琉华子，讨论他家&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 0, 0), rgb(255, 255, 255));&quot;&gt;新来的客人&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;从铃羽口中得知1998年篝失踪，计划寻找篝&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;把真由理送回家后和&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖讨论寻人方法&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="290" x="870" y="690" as="geometry" />
        </mxCell>
        <mxCell id="Y0y0fFugKPorP2vDXaIm-44" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="12月16日&lt;div&gt;在Lab和桶子、铃羽对齐寻人进度&lt;/div&gt;&lt;div&gt;和&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖讨论寻人，遇到菲莉丝、琉华子帮家里客人购物&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;帮琉华子搬东西回神社&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;新闻：美国加利福尼亚州，5名研究者失踪，其中3名研究AI&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;发现多具猩猩尸体，脑部、头部出现缺损&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="370" x="1320" y="745" as="geometry" />
        </mxCell>
        <mxCell id="Y0y0fFugKPorP2vDXaIm-46" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="12月17日&lt;div&gt;在大学看见教授&lt;/div&gt;&lt;div&gt;在秋叶原寻找篝的消息&lt;/div&gt;&lt;div&gt;在Lab和桶子、铃羽对齐寻人进度&lt;/div&gt;&lt;div&gt;委托萌郁调查篝&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="210" x="950" y="855" as="geometry" />
        </mxCell>
        <mxCell id="Y0y0fFugKPorP2vDXaIm-48" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="12月20日&lt;div&gt;真帆计划找人破解密码&lt;/div&gt;&lt;div&gt;真帆计划去Lab，在路上被跟踪&lt;/div&gt;&lt;div&gt;萌郁来Lab汇报寻人进度：有其他人也在找篝&lt;/div&gt;&lt;div&gt;真帆被茱蒂抱住，胸针赶到&lt;/div&gt;&lt;div&gt;真帆参观Lab，让胸针继续和&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖聊天&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="290" x="1320" y="890" as="geometry" />
        </mxCell>
        <mxCell id="WDOZ8VoKO_tG82dUvQUk-2" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="12月23日&lt;div&gt;圣诞派对取消，改为跨年派对&lt;/div&gt;&lt;div&gt;琉华子把篝(客人)带到Lab&lt;/div&gt;&lt;div&gt;篝的情况：&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;失去所有记忆，倒在千叶县山路上&lt;/font&gt;&lt;/div&gt;&lt;div&gt;让萌郁继续追查寻找篝的那伙人&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="260" x="900" y="955" as="geometry" />
        </mxCell>
        <mxCell id="WDOZ8VoKO_tG82dUvQUk-4" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="12月24日&lt;div&gt;带真由理去神社看望篝&lt;/div&gt;&lt;div&gt;计划跨年到神社参拜，之后在举办跨年派对&lt;/div&gt;&lt;div&gt;在秋叶原遇到找人帮忙破解密码的真帆&lt;/div&gt;&lt;div&gt;邀请真帆参加跨年的活动&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="250" x="1320" y="1015" as="geometry" />
        </mxCell>
        <mxCell id="WDOZ8VoKO_tG82dUvQUk-6" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="1月1日&lt;div&gt;去神社参拜，人员：胸针、桶子、由季、真帆、&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;枫、吹雪、绹、菲莉丝、&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;琉华子、真由理、铃羽、篝&lt;br&gt;&lt;/div&gt;&lt;div&gt;遇到教授和茱蒂来神社参拜&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;由季要打工，不参加跨年派对&lt;/font&gt;&lt;/div&gt;&lt;div&gt;举办跨年派对，枫、吹雪中途去买饮料&lt;/div&gt;&lt;div&gt;真帆向众人介绍&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖，&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖中途莫名消失&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;恐怖分子袭击Lab抓捕篝，&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 0, 0), rgb(255, 255, 255));&quot;&gt;地板留下弹孔&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;，天王寺救场，恐怖分子撤退&lt;/span&gt;&lt;/div&gt;&lt;div&gt;送众人回家，铃羽留在神社保护篝&lt;/div&gt;&lt;div&gt;篝梦中喊真由理妈妈，琉华子得知篝是真由理女儿，并和铃羽夜谈&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="390" x="770" y="1115" as="geometry" />
        </mxCell>
