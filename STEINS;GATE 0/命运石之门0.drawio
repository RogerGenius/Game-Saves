        <mxCell id="dODKMUwSG8sB8rNbBHXE-67" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="1月2日&lt;div&gt;和&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖打电话，讨论洗劫事件&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;结论：为了偷&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖的控制代码&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;真帆、萌郁入住菲莉丝家&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="240" x="2760" y="1825" as="geometry" />
