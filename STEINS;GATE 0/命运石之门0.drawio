        <mxCell id="M9H18jTt7FL1IyhOrPo9-18" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;2036年&lt;/font&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;3月7日&lt;/span&gt;&lt;br&gt;&lt;div&gt;了解原委后，胸针浅浅注意到：&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;世界被欺骗了&lt;/font&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;注：因为2010年的胸针被告知了他于2025年死去&lt;br&gt;&lt;/div&gt;&lt;div&gt;篝找过来，闲聊后，联系真由理等人，联系时她们被袭击了&lt;/div&gt;&lt;div&gt;铃羽、桶子、胸针慌忙赶去，敌人被击退，但琉华子死了&lt;/div&gt;&lt;div&gt;和桶子、真帆沟通后，打算回到过去&lt;/div&gt;&lt;div&gt;使用&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;精神崩溃的胸针一直戴着的时间跳跃微波炉&lt;/font&gt;回到过去&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="220" y="3705" as="geometry" />
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-19" edge="1" parent="1" source="M9H18jTt7FL1IyhOrPo9-9" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="M9H18jTt7FL1IyhOrPo9-18" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="3760" />
            </Array>
            <mxPoint x="530" y="3710" as="sourcePoint" />
            <mxPoint x="580" y="3660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-20" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;font color=&quot;#ff0000&quot;&gt;2011年1月31日 18:27&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;胸针经历数千次时间跳跃，成功回到2011年1月末&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;与之前世界线&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 0, 0), rgb(255, 255, 255));&quot;&gt;区别&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;：&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;胸针的记忆已经被数据化了&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;篝有儿时记忆，没有1998年后的记忆&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;真由理、琉华子知道篝身份&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;篝没有被植入红莉栖记忆&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;真帆还不知道关于胸针的事&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;预计48小时内，真帆将制作出时间跳跃机器&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;胸针手机上有&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Amadeus的软件&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;目前在Lab的有：胸针、桶子、真由理、菲莉丝、&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;琉华子、铃羽、篝、真帆&lt;br&gt;&lt;/div&gt;&lt;div&gt;目送其他人走后，真帆独自返回Lab&lt;/div&gt;&lt;div&gt;胸针和真帆讲述一切，闲聊后，友情加深&lt;/div&gt;&lt;div&gt;将回家路上的Labmem都叫回Lab&lt;/div&gt;&lt;div&gt;在要求铃羽打自己，并被打后，觉醒凤凰院胸针形态&lt;/div&gt;&lt;div&gt;宣布真帆是Labmem No.9，篝是&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Labmem No.10&lt;/span&gt;&lt;/div&gt;&lt;div&gt;重启前往“命运石之门”计划&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="300" x="720" y="3825" as="geometry" />
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-21" edge="1" parent="1" source="M9H18jTt7FL1IyhOrPo9-9" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="M9H18jTt7FL1IyhOrPo9-20" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="3960" />
            </Array>
            <mxPoint x="670" y="3890" as="sourcePoint" />
            <mxPoint x="720" y="3840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-22" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;span&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;2011年2月1日&lt;/font&gt;&lt;/span&gt;&lt;div&gt;10位Labmen都在Lab，闲聊后确定了计划内容：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1.废弃红莉栖的笔记本和硬盘&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2.删除&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus服务器中的红莉栖记忆数据&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;真帆发现无法访问&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus服务器，被拉黑了&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;教授和茱蒂打电话也打不通，只能由桶子黑红莉栖大学服务器&lt;/span&gt;&lt;/div&gt;&lt;div&gt;胸针准备好了微波炉，打算重现时间跳跃机器&lt;/div&gt;&lt;div&gt;桶子黑进服务器后发现：&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus和红莉栖记忆数据消失了&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;胸针立马看手机，发现手机上还有&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus软件&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;桶子发现红莉栖大学服务器中有个加密文件夹“Memory”&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;桶子又黑进“&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 0, 0); text-wrap-mode: wrap; background-color: transparent;&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;”服务器，真帆发现里面有记忆移植人体实验&lt;/span&gt;&lt;/div&gt;&lt;div&gt;桶子没有在“&lt;span style=&quot;color: rgb(255, 0, 0); text-wrap-mode: wrap; background-color: transparent;&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;”服务器中找到&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus和&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;红莉栖记忆数据&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;怀疑“&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 0, 0); text-wrap-mode: wrap; background-color: transparent;&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;”在还没获得&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus以及数据的情况下，做其他行动&lt;/span&gt;&lt;/div&gt;&lt;div&gt;胸针让桶子尝试解密红莉栖大学服务器里的加密文件夹“Memory”&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;胸针拜托真帆开发简易AI和&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖聊天，吸引&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;“&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: wrap; background-color: transparent; color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;”&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;注意力&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;胸针离开秋叶原，在东京站成功连上&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖并迅速挂断&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="400" x="160" y="3980" as="geometry" />
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-23" edge="1" parent="1" source="M9H18jTt7FL1IyhOrPo9-9" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="M9H18jTt7FL1IyhOrPo9-22" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="4100" />
            </Array>
            <mxPoint x="640" y="4030" as="sourcePoint" />
            <mxPoint x="690" y="3980" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-24" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;span&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;2011年2月2日&lt;/font&gt;&lt;/span&gt;&lt;div&gt;桶子还没解密文件夹成功&lt;/div&gt;&lt;div&gt;真帆完成了时间跳跃机器和简易AI：Salieri&lt;/div&gt;&lt;div&gt;和萌郁发消息：放出红莉栖笔记本和硬盘在胸针和真帆手上&lt;/div&gt;&lt;div&gt;计划开始：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1.在胸针手机上安装了模拟胸针的AI&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;在真帆手机上安装了模拟真帆的AI&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2.由真由理、琉华子、菲莉丝、铃羽，&lt;span style=&quot;white-space-collapse: preserve; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;分两组前往中央&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space-collapse: preserve; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;           线和山手线，并打开模拟AI和&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖对话，&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;为了引诱&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;“&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: wrap; background-color: transparent; color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;”&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;去找胸针和真帆，帮桶子解密文件&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;夹争&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;取时间&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;3.让由季陪篝前往桶子的秘密基地躲藏&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;注：暂时排除由季是敌人的可能性&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;4.因为要删除&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus以及红莉栖数据，所以胸针在秋&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;叶原桥中央和&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖告别&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;计划开始执行，胸针回到Lab&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;真帆发现篝曾是&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-wrap-mode: wrap; color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;”的实验对象，但实验前篝逃跑了&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;由季打来电话，说篝在听到道路宣传车的音乐后突然跑掉了&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;结论：篝曾被&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-wrap-mode: wrap; color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;”用K620号的5曲目“魔笛”洗脑&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;“&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: wrap; background-color: transparent; color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;”用胸针给篝的手机打电话给胸针说：&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;明天拿红莉栖的笔记本和硬盘来换篝&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;联系萌郁和铃羽回Lab，计划突袭&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-wrap-mode: wrap; color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;”支部救篝&lt;/span&gt;&lt;/div&gt;&lt;div&gt;胸针和铃羽两人前往&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-wrap-mode: wrap; color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;”，即&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;东京机电大学&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;发现的幕后黑手茱蒂，她身为“DURPA”潜入&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-wrap-mode: wrap; color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;”做&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;间谍，被&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-wrap-mode: wrap; color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;”发现后杀害&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-wrap-mode: wrap; color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;”的人，并挟持篝，胸&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;针为了给桶子拖延时间，化身凤凰院胸针形态和茱蒂对话，&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;得知她和“DURPA”是美国官方阵营，为了制造听话且高智商&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;的AI士兵和抢先制造时间机器，而潜入&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“&lt;/span&gt;&lt;span style=&quot;background-color: transparent; text-wrap-mode: wrap; color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;”，并夺取篝&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;、&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Amadeus红莉栖以及红莉栖的笔记本和硬盘&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;茱蒂打算放弃红莉栖的笔记本和硬盘，直接将红莉栖记&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;忆覆盖进篝的大脑，但系统出问题，覆盖失败，篝醒来了，&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;茱蒂打算直接将红莉栖记忆覆盖到自己大脑中，但桶子先一&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;步删除了红莉栖大学服务器中加密文件夹中的红莉栖记忆数&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;据，导致茱蒂覆盖了空白的记忆数据，变成了行尸走肉&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="520" width="350" x="720" y="4120" as="geometry" />
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-25" edge="1" parent="1" source="M9H18jTt7FL1IyhOrPo9-9" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="M9H18jTt7FL1IyhOrPo9-24" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="4380" />
            </Array>
            <mxPoint x="650" y="3780" as="sourcePoint" />
            <mxPoint x="800" y="4270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-26" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;span&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;2011年2月6日&lt;/font&gt;&lt;/span&gt;&lt;div&gt;吹雪、枫、由季来到Lab玩，之后离开了&lt;/div&gt;&lt;div&gt;分析了2号时，覆盖篝记忆失败的原因：&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖自己阻止了&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;分析了世界线没有变动的原因：&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;暂时认为是&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus和红莉栖的记忆数据被删除了&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;铃羽也和胸针关系融洽起来&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;发放11人款的Labmem徽章&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;这之后，真帆回到了美国&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="460" x="100" y="4655" as="geometry" />
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-27" edge="1" parent="1" source="M9H18jTt7FL1IyhOrPo9-9" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="M9H18jTt7FL1IyhOrPo9-26" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="4720" />
            </Array>
            <mxPoint x="430" y="4560" as="sourcePoint" />
            <mxPoint x="480" y="4510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-28" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;span&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;2011年12月18日&lt;/font&gt;&lt;/span&gt;&lt;div&gt;真帆再次来到日本和Lab&lt;/div&gt;&lt;div&gt;桶子升级了时间跳跃机器微波炉，连接了内部使用的RINE软件&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;注：继续用旧版发送邮件的话，会被SERN捕捉到&lt;br&gt;&lt;/div&gt;&lt;div&gt;从Dmail改动后，叫做DRine，但无法向RINE软件开发前发消息&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;为了前往命运石之门世界线，需要前往并改变其他世界线，&lt;/div&gt;&lt;div&gt;所以要发送DRine给过去的胸针，提醒他“世界是可以被欺骗的”。&lt;/div&gt;&lt;div&gt;然后过去的胸针意识到后会做出不一样的决定，进而使当前世界&lt;/div&gt;&lt;div&gt;线的胸针直接跳跃到“不一样决定”后的世界线，在多个世界线&lt;/div&gt;&lt;div&gt;跳跃并做准备，为前往命运石之门世界线做铺垫&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="360" x="720" y="4715" as="geometry" />
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;span style=&quot;font-family: &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; text-align: start;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;红莉栖结局&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="80" x="600" y="4920" as="geometry" />
        </mxCell>
        <mxCell id="M9H18jTt7FL1IyhOrPo9-30" edge="1" parent="1" source="M9H18jTt7FL1IyhOrPo9-9" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="M9H18jTt7FL1IyhOrPo9-28" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="4800" />
            </Array>
            <mxPoint x="680" y="4720" as="sourcePoint" />
            <mxPoint x="730" y="4670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3eP3UokEhXtUZL2HKDDa-1" edge="1" parent="1" source="Y0y0fFugKPorP2vDXaIm-24" style="endArrow=classic;html=1;rounded=0;" target="3eP3UokEhXtUZL2HKDDa-11" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="3550" y="780" as="sourcePoint" />
            <mxPoint x="3600" y="1370" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3eP3UokEhXtUZL2HKDDa-2" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="12月15日&lt;div&gt;胸针在路上和吹雪、枫并聊天&lt;/div&gt;&lt;div&gt;聊天喜欢的人，想起红莉栖死状，&lt;span style=&quot;color: rgb(255, 0, 0); background-color: transparent;&quot;&gt;然后收到RINE消息&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(前提：通过红莉栖线&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;RINE消息：“欺骗世界吧”&lt;/font&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;和教授汇报&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus测试情况，打算卸任测试员职位&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;原因：怕把&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus当成真红莉栖&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;结果：成功卸任，但依旧可以使用&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;教授离开和某人打电话去了，与真帆聊天&lt;/div&gt;&lt;div&gt;和真帆聊起红莉栖妈妈家被纵火&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;犯人：&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 0, 0), rgb(255, 255, 255));&quot;&gt;疑似俄国特种部队&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;补充：惊动FBI调查(不确定FBI真假)&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;和真帆聊起日美警察联合调查红莉栖大学实验室&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;调查原因：为调查红莉栖死亡案件&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;补充：日美警察全是假的，不确定真实身份&lt;br&gt;&lt;/div&gt;&lt;div&gt;真帆怀疑红莉栖案件另有玄机，怀疑胸针知道什么内情&lt;/div&gt;&lt;div&gt;教授回来了，喊真帆、胸针一起去吃饭，去地下停车场坐车去&lt;/div&gt;&lt;div&gt;男主大学副教授 - 井崎，开车来接教授、真帆、胸针去吃饭&lt;/div&gt;&lt;div&gt;遇到持枪袭击者，井崎跑了，胸针受伤&lt;/div&gt;&lt;div&gt;袭击者被暗处中另一个持枪神秘人击毙，胸针一行人报警&lt;/div&gt;&lt;div&gt;在警察护送下，胸针回家，教授、真帆回和光市酒店&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="420" x="3100" y="760" as="geometry" />
        </mxCell>
        <mxCell id="3eP3UokEhXtUZL2HKDDa-4" edge="1" parent="1" source="3eP3UokEhXtUZL2HKDDa-2" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="Y0y0fFugKPorP2vDXaIm-24" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="3600" y="910" />
            </Array>
            <mxPoint x="3450" y="980" as="sourcePoint" />
            <mxPoint x="3500" y="930" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3eP3UokEhXtUZL2HKDDa-5" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="12月19日&lt;div&gt;寻找篝的铃羽发烧头疼，回Lab遇到真由理、桶子、由季&lt;/div&gt;&lt;div&gt;铃羽休息，桶子去买药，真由理、由季照顾铃羽，真由理煮粥，&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;由季洗澡唱歌&lt;/font&gt;&lt;/div&gt;&lt;div&gt;桶子回来后，铃羽对自己的任务自责，桶子安慰铃羽&lt;/div&gt;&lt;div&gt;桶子提出想帮偷偷寻找篝的铃羽的忙，铃羽打算下次再说&lt;/div&gt;&lt;div&gt;铃羽睡着梦到篝，醒来发现桶子去咖啡厅了，真由理正准备去咖啡厅打工&lt;/div&gt;&lt;div&gt;真由理走后，由季想帮铃羽换擦背，铃羽怕暴露伤口，不小心对由季爆粗口&lt;/div&gt;&lt;div&gt;尴尬的由季去给铃羽盛吃的，陪铃羽吃饭聊天，气氛有所缓解&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="430" x="3680" y="975" as="geometry" />
        </mxCell>
        <mxCell id="3eP3UokEhXtUZL2HKDDa-6" edge="1" parent="1" source="3eP3UokEhXtUZL2HKDDa-5" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="Y0y0fFugKPorP2vDXaIm-24" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="3670" y="990" as="sourcePoint" />
            <mxPoint x="3720" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3eP3UokEhXtUZL2HKDDa-7" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="12月21日&lt;div&gt;桶子联系胸针在咖啡厅见，胸针带真帆来咖啡厅&lt;/div&gt;&lt;div&gt;真帆和菲莉丝聊天，桶子和胸针谈正事&lt;/div&gt;&lt;div&gt;胸针得知篝是真由理女儿，以及有人要破解红莉栖笔记本硬盘的事&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="370" x="3150" y="1125" as="geometry" />
        </mxCell>
        <mxCell id="3eP3UokEhXtUZL2HKDDa-8" edge="1" parent="1" source="3eP3UokEhXtUZL2HKDDa-7" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="Y0y0fFugKPorP2vDXaIm-24" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="3290" y="1150" as="sourcePoint" />
            <mxPoint x="3340" y="1100" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3eP3UokEhXtUZL2HKDDa-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;12月24日&lt;/span&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;因为不好意思，想通过真帆向&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖道歉，便来到和光市办公室&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;和真由理打电话，约好晚上在Lab举办圣诞节派对&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;在真帆的陪同下向&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Amadeus红莉栖道歉&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;Amadeus红莉栖原谅的前提：今天圣诞节，和真帆约会吃饭&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;胸针邀请真帆去Lab圣诞派对，教授也跟来了，&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖勉强原谅&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;在广播馆维护时间机器的铃羽想到了篝，深深自责，桶子安慰铃羽&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;胸针带真帆、教授来到Lab参加派对，人员有：胸针、真帆、教授、真由理、&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;菲莉丝、琉华子、由季、枫、&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;吹雪、绹、(桶子、铃羽一会到)&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;关灯打算给铃羽一个惊喜，想把铃羽逗笑，铃羽却被吓到差点打伤由季&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;误会解除，派对开始，互相交换礼物&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;补充：此时可以给&lt;span style=&quot;background-color: transparent;&quot;&gt;Amadeus红莉栖打电话，会被凶并被祝福圣诞节快乐&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;铃羽问由季，在19号铃羽休息时，在Lab洗澡的由季哼的是什么歌，&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 0, 0), rgb(255, 255, 255));&quot;&gt;世界线发生变动&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;变动原因：大概因为俄罗斯的时间机器研发进度过快，进行了实验导致&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="480" x="3360" y="1240" as="geometry" />
        </mxCell>
