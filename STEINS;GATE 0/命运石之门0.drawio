        <mxCell id="dODKMUwSG8sB8rNbBHXE-59" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;区别&lt;/font&gt;：&lt;div&gt;吹雪、枫、菲莉丝不在Lab，&lt;div&gt;真由理、桶子、真帆、萌郁在Lab&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus没有被劫持&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;，没有故障&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;1月1日：&lt;/div&gt;&lt;div&gt;跨年派对时，琉华子父亲说可能找到了篝的家人&lt;/div&gt;&lt;div&gt;跨年派对后，真帆得知，和光市办公室煤气泄漏&lt;/div&gt;&lt;div&gt;真帆和教授在胸针学校租办公室使用&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1月2日：&lt;/div&gt;&lt;div&gt;铃羽、琉华子及其父亲陪篝去了岩手见家人&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;萌郁找真帆取材，真帆酒店房间被入侵洗劫&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;萌郁带真帆到Lab休息&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="280" x="2320" y="1635" as="geometry" />
        </mxCell>
