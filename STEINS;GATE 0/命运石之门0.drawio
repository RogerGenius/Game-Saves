        <mxCell id="dODKMUwSG8sB8rNbBHXE-69" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="1月3日&lt;div&gt;胸针去菲莉丝家查看真帆、萌郁情况&lt;/div&gt;&lt;div&gt;胸针协助萌郁向真帆进行采访&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="220" x="2380" y="1890" as="geometry" />
