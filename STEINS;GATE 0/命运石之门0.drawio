            <mxPoint x="-2000" y="1960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;1月2日&lt;/span&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;胸针穿越回α世界线，在Lab遇见未死的红莉栖&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;红莉栖找借口支开胸针去买咖啡，胸针察觉中途折回&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;世界线背景：真由理死亡，“电话微波炉(暂定)”被胸针毁掉，&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; 胸针、桶子不再来Lab，胸针一直责备自己，&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space-collapse: preserve;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; 12月初，红莉栖重造“电话微波炉(暂定)改”&lt;/div&gt;&lt;div style=&quot;text-wrap-mode: nowrap;&quot;&gt;红莉栖和胸针坦白，温情过后鼓励胸针，&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;发送Dmail送胸针回β世界线&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="400" x="-1480" y="1640" as="geometry" />
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;span style=&quot;font-family: &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; text-align: start;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;0.571082&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="80" x="-1320" y="1480" as="geometry" />
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-18" edge="1" parent="1" source="jGzBVktFIb3ai4ShvgAQ-17" style="endArrow=classic;html=1;rounded=0;" target="jGzBVktFIb3ai4ShvgAQ-16" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-1270" y="1550" as="sourcePoint" />
            <mxPoint x="-1270" y="1590" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;span style=&quot;font-family: &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; text-align: start;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;1.053649&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="80" x="-520" y="1720" as="geometry" />
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-20" edge="1" parent="1" source="jGzBVktFIb3ai4ShvgAQ-16" style="endArrow=classic;html=1;rounded=0;" target="jGzBVktFIb3ai4ShvgAQ-19" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-420" y="1640" as="sourcePoint" />
            <mxPoint x="-370" y="1590" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;span style=&quot;font-family: &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; text-align: start;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;1.053649&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="80" x="-520" as="geometry" />
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-22" edge="1" parent="1" source="jGzBVktFIb3ai4ShvgAQ-11" style="endArrow=classic;html=1;rounded=0;dashed=1;" target="jGzBVktFIb3ai4ShvgAQ-21" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-580" y="140" as="sourcePoint" />
            <mxPoint x="-750" y="-80" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-23" edge="1" parent="1" source="jGzBVktFIb3ai4ShvgAQ-19" style="endArrow=none;html=1;rounded=0;dashed=1;dashPattern=12 12;" target="jGzBVktFIb3ai4ShvgAQ-21" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-481.1100000000006" y="1710" as="sourcePoint" />
            <mxPoint x="-481.1100000000006" y="90" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-24" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;区别&lt;/font&gt;：和两次命运探知之前比较&lt;div&gt;真由理、琉华子、篝在Lab&lt;/div&gt;&lt;div&gt;胸针告知了真由理，篝是她未来女儿&lt;/div&gt;&lt;div&gt;琉华子知道真由理和篝是母女，以及时间机器的事&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;篝有儿时的记忆&lt;/font&gt;，即2036年的记忆&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;篝没有和铃羽穿越到过去后的记忆&lt;/font&gt;&lt;/div&gt;&lt;div&gt;篝只记得，倒在千叶县深山路上之后的记忆&lt;/div&gt;&lt;div&gt;是胸针主动带篝去见真由理的&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;地板没有弹孔&lt;/font&gt;，1月1日晚跨年派对没有被恐怖分子袭击&lt;/div&gt;&lt;div&gt;虽然Lab没被袭击，但篝依旧在显像管打工了&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;红莉栖死后，Amadeus项目被冻结，胸针手机上没有安装&lt;span style=&quot;background-color: transparent;&quot;&gt;Amadeus&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;11月23日，没有举行真帆、教授的&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus项目演讲&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;真帆和胸针的相识：真帆去红莉栖死的地方(广播馆)，遇到胸针&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="380" x="-940" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-25" edge="1" parent="1" source="jGzBVktFIb3ai4ShvgAQ-19" style="endArrow=classic;html=1;rounded=0;" target="VgDJv4e0kdATJ_0Rd5Iz-9" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-430" y="1830" as="sourcePoint" />
            <mxPoint x="-480" y="2960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-27" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="1月2日&lt;div&gt;怀疑是&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus红莉栖引起世界线变动，却发现&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus没有安装&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;约见真帆询问&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus事情，以及和真帆相识的事情&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;怀疑与真帆相遇是世界线收束的结果，思考一定会和真帆相识的意义&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;胸针回到Lab，整理思绪，用RINE联系某人(应该是桶子/萌郁)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;篝和琉华子聊天看电视，电视播报有关红莉栖大学研究所的录像和介绍&lt;/div&gt;&lt;div&gt;篝有着研究所、脑科学知识的记忆&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="-400" y="1965" as="geometry" />
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-28" edge="1" parent="1" source="jGzBVktFIb3ai4ShvgAQ-24" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="jGzBVktFIb3ai4ShvgAQ-19" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="-480" y="1880" />
            </Array>
            <mxPoint x="-680" y="1850" as="sourcePoint" />
            <mxPoint x="-480" y="1800" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-29" edge="1" parent="1" source="jGzBVktFIb3ai4ShvgAQ-27" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="jGzBVktFIb3ai4ShvgAQ-19" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-560" y="1980" as="sourcePoint" />
            <mxPoint x="-479.93333333333294" y="1820" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-30" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="1月3日&lt;div&gt;在显像管，再次和天王寺摊牌α世界线的部分事，委托她保护篝&lt;/div&gt;&lt;div&gt;提到昨天在Lab用RINE联系某人：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;先联系桶子，询问关于请萌郁调查的事&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;后联系萌郁，请她调查篝来秋叶原之前在做什么&lt;br&gt;&lt;/div&gt;&lt;div&gt;琉华子来到Lab，和胸针提起昨晚关于篝有着红莉栖大学研究所记忆的事&lt;/div&gt;&lt;div&gt;约见篝、真帆讨论篝的失忆，过程中，篝频繁说出只有红莉栖知道的事&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;结论&lt;/span&gt;：篝的大脑，被植入了红莉栖的记忆，导致记忆混乱，从而失忆&lt;br&gt;&lt;/div&gt;&lt;div&gt;篝过于疲惫，和琉华子回神社休息&lt;/div&gt;&lt;div&gt;真帆回和光市办公室，打算尝试提取&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus中红莉栖的记忆&lt;/span&gt;&lt;/div&gt;&lt;div&gt;晚上，胸针和铃羽、桶子在Lab讨论篝的事，猜测结论：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;篝是在到达1998年失踪后，被人植入记忆的&lt;br&gt;&lt;/div&gt;&lt;div&gt;接着询问桶子，关于由季的工作(在蛋糕店打工)，怀疑由季是袭击者&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="410" x="-970" y="2020" as="geometry" />
        </mxCell>
        <mxCell id="VgDJv4e0kdATJ_0Rd5Iz-1" edge="1" parent="1" source="jGzBVktFIb3ai4ShvgAQ-30" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="jGzBVktFIb3ai4ShvgAQ-19" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-530" y="2070" as="sourcePoint" />
            <mxPoint x="-480" y="2020" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgDJv4e0kdATJ_0Rd5Iz-2" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="1月4日&lt;div&gt;真帆、篝在Lab集合，继续验证篝脑中关于红莉栖的记忆，得出结论：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;篝可能被植入了&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus中的红莉栖的记忆数据&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;回到和光市办公室的真帆回想死去红莉栖、冻结的&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus和篝的事&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;教授突然回来和光市办公室，真帆向教授询问&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amadeus中数据的安全问题&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;结论：教授说很安全，但总的来说答案是“不确定”，只能自己探索&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;茱蒂教授也来和光市办公室，茱蒂、真帆、教授，3人闲聊&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="-400" y="2195" as="geometry" />
        </mxCell>
        <mxCell id="VgDJv4e0kdATJ_0Rd5Iz-3" edge="1" parent="1" source="VgDJv4e0kdATJ_0Rd5Iz-2" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="jGzBVktFIb3ai4ShvgAQ-19" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-450" y="2190" as="sourcePoint" />
            <mxPoint x="-400" y="2140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgDJv4e0kdATJ_0Rd5Iz-4" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="1月6日&lt;div&gt;与真由理、篝、琉华子在Lab闲聊并问起篝最近的状态&lt;/div&gt;&lt;div&gt;篝的脑中越发频繁的出现红莉栖的记忆，比如：红莉栖父亲的事&lt;/div&gt;&lt;div&gt;篝提及小时候做过PTSD的治疗&lt;/div&gt;&lt;div&gt;真由理、琉华子离开Lab，去参加升学宣讲会，将篝临时托付给胸针&lt;/div&gt;&lt;div&gt;胸针带篝去购物，路上篝代替未来的真由理、桶子等人鼓励胸针&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;路上聊起真由理小时候成为胸针“人质”的事&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;带篝去菲莉丝的咖啡厅吃饭，人太多，故离开&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;篝提议回Lab吃杯面，买了很多杯面回去&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;为篝买了属于她的“专属叉子”，貌似为了弥补红莉栖的遗憾&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;回Lab路上聊起红莉栖的事，有助于篝了解红莉栖&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;篝突然头痛，说着“不要！不想回到那里！谁来救救我？&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;救救我&lt;/span&gt;，妈妈！为什么不来救我？”&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;胸针扶着痛苦的篝回Lab休息&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;回Lab后，篝睡着了，胸针通知了真由理、琉华子，回想路上篝说的话&lt;/div&gt;&lt;div&gt;真由理、琉华子赶来Lab，篝醒来记忆错乱，以为自己是刚来日本的红莉栖&lt;/div&gt;&lt;div&gt;胸针唤醒篝后，篝头痛惨叫后昏倒，稳定后送回神社，真由理留下陪篝和琉华子&lt;/div&gt;&lt;div&gt;胸针联系铃羽、真帆在Lab集合，为了篝，胸针和真帆坦白了所有事情&lt;/div&gt;&lt;div&gt;铃羽提及三战的起因是欧盟和俄罗斯抢夺时间机器，美国横插一脚后一发不可收拾&lt;/div&gt;&lt;div&gt;推测：有人想获得红莉栖的时间机器论文，便把红莉栖的记忆植入篝，后逼问出来&lt;/div&gt;&lt;div&gt;胸针想起α线的桶子说过：人脑记忆的容量是3.24TB&lt;/div&gt;&lt;div&gt;计划修复篝的记忆，用篝完整的记忆数据重新覆盖篝的大脑，具体步骤：&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1.利用红莉栖时间机器理论造出时间跳跃机器&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;2.想办法找到篝完整的记忆数据&lt;br&gt;&lt;/div&gt;&lt;div&gt;铃羽带真帆离开Lab去广播馆看时间机器，后真帆坐地铁去和光市办公室拿行李入住Lab&lt;/div&gt;&lt;div&gt;真帆到办公室后，教授也在，发现办公室被洗劫&lt;/div&gt;&lt;div&gt;真帆和教授请假，回酒店收拾行李准备入住Lab，全身心研究&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;时间跳跃机器&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="420" width="480" x="-1040" y="2270" as="geometry" />
        </mxCell>
        <mxCell id="VgDJv4e0kdATJ_0Rd5Iz-5" edge="1" parent="1" source="VgDJv4e0kdATJ_0Rd5Iz-4" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="jGzBVktFIb3ai4ShvgAQ-19" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-640" y="2210" as="sourcePoint" />
            <mxPoint x="-590" y="2160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgDJv4e0kdATJ_0Rd5Iz-6" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="1月11日&lt;div&gt;对于篝的记忆数据毫无进展，也找不到恐怖分子的踪迹&lt;/div&gt;&lt;div&gt;确定一点：幼年篝被带走进行试验，直到近期才逃出来&lt;/div&gt;&lt;div&gt;时间跳跃机器的制作稳步进行，篝的大脑遭到红莉栖记忆大量侵蚀&lt;/div&gt;&lt;div&gt;胸针带篝出门散心，一起前往广播馆，胸针想起和红莉栖的初遇，篝安慰胸针&lt;/div&gt;&lt;div&gt;因为下雨，为防止生病前往琉华子家，真由理也在&lt;/div&gt;&lt;div&gt;真由理、篝准备去洗澡时，篝记忆错乱昏倒，雨停后胸针回Lab，篝还在昏迷&lt;/div&gt;&lt;div&gt;胸针刚回Lab，真帆、桶子就完成了时间跳跃机器&lt;/div&gt;&lt;div&gt;真帆得知，自己的酒店房间被洗劫，&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;红莉栖的笔记本电脑在桶子那，没被偷&lt;/span&gt;&lt;/div&gt;&lt;div&gt;计划利用篝引出恐怖分子，逼问情报&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="430" x="-400" y="2600" as="geometry" />
        </mxCell>
        <mxCell id="VgDJv4e0kdATJ_0Rd5Iz-7" edge="1" parent="1" source="VgDJv4e0kdATJ_0Rd5Iz-6" style="endArrow=none;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" target="jGzBVktFIb3ai4ShvgAQ-19" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="-480" y="2640" as="sourcePoint" />
            <mxPoint x="-480" y="1700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VgDJv4e0kdATJ_0Rd5Iz-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;" value="1月15日&lt;div&gt;铃羽假扮篝引出恐怖分子，联手天王寺、胸针成功抓住一人逼问情报&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(应该是凌晨)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;得知寻找篝、给篝植入红莉栖记忆的组织是“&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Stratfor&lt;/font&gt;”，桶子开始黑进其服务器&lt;/div&gt;&lt;div&gt;天王寺进行善后工作，胸针、铃羽赶往Lab&lt;/div&gt;&lt;div&gt;胸针、铃羽、真由理、菲莉丝、琉华子、篝、桶子、真帆都在Lab&lt;/div&gt;&lt;div&gt;篝记忆错乱达到临界值，以红莉栖的记忆人格请求胸针把自己从篝的大脑中移除&lt;/div&gt;&lt;div&gt;Lab被Stratfor的人包围，桶子成功黑进Stratfor的服务器&lt;/div&gt;&lt;div&gt;在文件路径“/John/”中找到篝的记忆数据文件“&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;K6205.bin&lt;/font&gt;”，&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(John：莫扎特的洗礼名是“Johannes”)&lt;/div&gt;&lt;div&gt;桶子进行时间跳跃机器的流程，Stratfor的人冲上Lab的二楼楼梯，铃羽奋力抵住门&lt;/div&gt;&lt;div&gt;携带篝完整记忆的数据通过SERN的LHC压缩后，通过手机电话拨打至胸针手机&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="480" x="-720" y="2880" as="geometry" />
        </mxCell>
        <mxCell id="VgDJv4e0kdATJ_0Rd5Iz-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;Helvetica Neue, Helvetica, Arial, sans-serif&quot; color=&quot;#333333&quot;&gt;主动接电话&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0); font-family: &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; background-color: transparent;&quot;&gt;手机贴在篝脸颊上的那一刻，发生世界线跳跃&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="320" x="-640" y="3200" as="geometry" />
        </mxCell>
        <mxCell id="VgDJv4e0kdATJ_0Rd5Iz-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;Helvetica Neue, Helvetica, Arial, sans-serif&quot; color=&quot;#333333&quot;&gt;主动挂断电话，但篝拦住胸针，主动接电话&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;Helvetica Neue, Helvetica, Arial, sans-serif&quot; color=&quot;#333333&quot;&gt;/ 不做决定，等篝主动接电话&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: start;&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot; face=&quot;Helvetica Neue, Helvetica, Arial, sans-serif&quot;&gt;手机贴在篝脸颊上的那一刻，发生世界线跳跃&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="-120" y="2960" as="geometry" />
        </mxCell>
        <mxCell id="VgDJv4e0kdATJ_0Rd5Iz-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;span style=&quot;font-family: &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; text-align: start;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;1.064756&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="80" x="1720" as="geometry" />
        </mxCell>
