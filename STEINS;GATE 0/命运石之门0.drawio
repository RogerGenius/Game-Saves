              <mxPoint x="2680" y="2100" />
            </Array>
            <mxPoint x="2810" y="2220" as="sourcePoint" />
            <mxPoint x="2759.95652173913" y="1660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-9" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="1月31日&lt;div&gt;真帆坐飞机回美国&lt;/div&gt;&lt;div&gt;总结：教授死了，茱蒂侥幸没死，萌郁没死&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;真帆得知胸针的所有事并见到了时间机器&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp;得知命运石之门的存在&lt;br&gt;&lt;/div&gt;&lt;div&gt;未来预测：借助红莉栖笔记本里的知识造时间机器，尝试抵达命运石之门&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="410" x="2760" y="2110" as="geometry" />
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;span style=&quot;font-family: &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; text-align: start;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;真帆结局&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="80" x="2640" y="2240" as="geometry" />
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;" value="&lt;span style=&quot;color: rgb(51, 51, 51); font-family: &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; text-align: start;&quot;&gt;0.571082&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="80" x="-1320" as="geometry" />
        </mxCell>
        <mxCell id="jGzBVktFIb3ai4ShvgAQ-12" edge="1" parent="1" source="M9H18jTt7FL1IyhOrPo9-1" style="endArrow=classic;html=1;rounded=0;dashed=1;" target="dODKMUwSG8sB8rNbBHXE-49" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
